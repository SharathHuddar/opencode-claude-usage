  "description": "OpenCode TUI plugin: live Claude plan usage (5h / weekly limits) in the sidebar while a Claude Agent model is selected.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SharathHuddar/opencode-claude-usage.git"
  },
